{
  "name": "command-deck",
  "main": "server/index.ts",
  "compatibility_date": "2026-09-01",
  // Static files come from dist/; only /api/* runs the Worker. Unknown paths fall back to the SPA.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // The domain's DNS record and SSL certificate are created on deploy; the zone must be on this account.
  // study. stays attached so old links and calendar subscriptions keep working; remove it once nothing uses it.
  "routes": [
    { "pattern": "deck.advaitachandra.in", "custom_domain": true },
    { "pattern": "study.advaitachandra.in", "custom_domain": true }
  ],
  "vars": {
    "ALLOWED_GOOGLE_EMAILS": "advaita974@gmail.com",
    "GOOGLE_REDIRECT_URI": "https://deck.advaitachandra.in/api/auth/google/callback",
    "GOOGLE_CALENDAR_REDIRECT_URI": "https://deck.advaitachandra.in/api/google/callback"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "command-deck",
      "database_id": "6e3e949b-847d-429a-ad4b-8ffe0aea1893",
      "migrations_dir": "migrations"
    }
  ]
}

{
  "name": "exam-tracker",
  "main": "server/index.ts",
  "compatibility_date": "2026-09-01",
  // Static files come from dist/; only /api/* runs the Worker. Unknown paths fall back to the SPA.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // The domain's DNS record and SSL certificate are created on deploy; the zone must be on this account.
  "routes": [{ "pattern": "study.advaitachandra.in", "custom_domain": true }],
  "vars": {
    "ALLOWED_GOOGLE_EMAILS": "advaita974@gmail.com",
    "GOOGLE_REDIRECT_URI": "https://study.advaitachandra.in/api/auth/google/callback",
    "GOOGLE_CALENDAR_REDIRECT_URI": "https://study.advaitachandra.in/api/google/callback"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "exam-tracker",
      "database_id": "c3ab950b-26ad-492d-999b-4b801a1e045d",
      "migrations_dir": "migrations"
    }
  ]
}
